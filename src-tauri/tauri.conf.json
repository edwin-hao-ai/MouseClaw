{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseClaw",
  "version": "0.3.2",
  "identifier": "com.edwinhao.mouseclaw",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/fetch-sherpa-model.sh && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "mouse",
        "title": "MouseClaw",
        "width": 320,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false,
        "shadow": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["/tmp/**", "/private/var/folders/**", "$HOME/.mouseclaw/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "resources": {
      "resources/sherpa-zh-en/encoder-epoch-99-avg-1.int8.onnx": "models/sherpa-zh-en/encoder-epoch-99-avg-1.int8.onnx",
      "resources/sherpa-zh-en/decoder-epoch-99-avg-1.onnx":      "models/sherpa-zh-en/decoder-epoch-99-avg-1.onnx",
      "resources/sherpa-zh-en/joiner-epoch-99-avg-1.int8.onnx":  "models/sherpa-zh-en/joiner-epoch-99-avg-1.int8.onnx",
      "resources/sherpa-zh-en/tokens.txt":                       "models/sherpa-zh-en/tokens.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "Developer ID Application: Beijing VGO Co;Ltd (5XNDF727Y6)",
      "entitlements": "entitlements.plist"
    }
  }
}
